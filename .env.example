# LLM provider: openai | anthropic
LLM_PROVIDER=openai

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Server
HOST=127.0.0.1
PORT=8765

# TTS (edge-tts voice). Common: en-US-GuyNeural, en-IN-NeerjaNeural, hi-IN-MadhurNeural
TTS_VOICE=en-IN-PrabhatNeural

# Optional: Whisper API for STT if you prefer server-side speech-to-text
# (Frontend uses free browser Web Speech API by default)
WHISPER_STT=false
