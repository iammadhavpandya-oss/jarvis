# LLM provider: ollama (free, local) | openai | anthropic
# Recommended: Ollama — no cloud API key needed
LLM_PROVIDER=ollama

# --- Ollama (free local) — install https://ollama.com then: ollama pull llama3.2:3b ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:3b
# Alternatives: llama3.2:1b (lighter), llama3.1:8b (heavier / better)

# --- OpenAI (paid cloud) ---
# LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (paid cloud) ---
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Server
HOST=127.0.0.1
PORT=8765

# TTS (edge-tts voice). Common: en-US-GuyNeural, en-IN-NeerjaNeural, hi-IN-MadhurNeural
TTS_VOICE=en-IN-PrabhatNeural

# Optional: Whisper API for STT if you prefer server-side speech-to-text
# (Frontend uses free browser Web Speech API by default)
WHISPER_STT=false

# Chat context window (turns kept for local models)
MAX_CONTEXT_TURNS=20
